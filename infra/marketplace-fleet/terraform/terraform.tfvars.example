project = "bountynet-marketplace"

do_token = "dop_v1_xxx"
domain_name = "bountynet.ai"
hostname = "llm"

provision_do_regional_lbs = true
provision_do_global_lbs = true
enable_aws_global_accelerator = false
include_aws_anycast_alias = false

entry_port = 443
target_port = 4000
healthcheck_port = 4000
service_port = 4000

droplet_size = "s-2vcpu-4gb"
droplet_image = "ubuntu-24-04-x64"
ssh_key_fingerprints = ["aa:bb:cc:dd"]
gateway_docker_image = "ghcr.io/berriai/litellm:main-stable"

model_api_region = "eu-central-1"
aws_control_plane_region = "eu-central-1"
enable_managed_secret_bootstrap = false
aws_secrets_region = "eu-central-1"
aws_kms_key_arn = "arn:aws:kms:eu-central-1:123456789012:key/xxxx-xxxx"
secret_parameter_names = {
  openai    = "/bountynet/market/edge/openai_api_key"
  anthropic = "/bountynet/market/edge/anthropic_api_key"
  gemini    = "/bountynet/market/edge/gemini_api_key"
  openrouter = "/bountynet/market/edge/openrouter_api_key"
}
litellm_master_key = ""
litellm_salt_key = ""

regional_plan = {
  na_west = {
    region         = "sfo3"
    droplet_count  = 2
    droplet_tag    = "bountynet-edge-na-west"
    traffic_weight = 20
  }
  na_east = {
    region         = "nyc3"
    droplet_count  = 2
    droplet_tag    = "bountynet-edge-na-east"
    traffic_weight = 20
  }
  eu = {
    region         = "fra1"
    droplet_count  = 3
    droplet_tag    = "bountynet-edge-eu"
    traffic_weight = 30
  }
  asia = {
    region         = "sgp1"
    droplet_count  = 2
    droplet_tag    = "bountynet-edge-asia"
    traffic_weight = 20
  }
  australia = {
    region         = "syd1"
    droplet_count  = 1
    droplet_tag    = "bountynet-edge-australia"
    traffic_weight = 10
  }
}

primary_region = "nyc3"
backup_region = "sfo3"
primary_droplet_tag = "bountynet-edge-na-east"
backup_droplet_tag = "bountynet-edge-na-west"

record_ttl = 30
backup_hostname = "llm-backup"

listener_port = 443
endpoint_port = 8000
# AWS anycast endpoint order: Frankfurt primary, Ireland secondary, London tertiary.
endpoint_groups = {
  frankfurt_primary = {
    region                  = "eu-central-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-central-1:123456789012:loadbalancer/net/bountynet-frankfurt/..."
    traffic_dial_percentage = 60
    weight                  = 128
  }
  ireland_secondary = {
    region                  = "eu-west-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/net/bountynet-ireland/..."
    traffic_dial_percentage = 25
    weight                  = 128
  }
  london_tertiary = {
    region                  = "eu-west-2"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-west-2:123456789012:loadbalancer/net/bountynet-london/..."
    traffic_dial_percentage = 15
    weight                  = 128
  }
}

# Optional AWS model-plane lanes
provision_aws_inf2_serving = false
aws_inf2_region = "eu-central-1"
aws_inf2_instance_type = "inf2.xlarge"
aws_inf2_ssh_key_name = "your-keypair"
aws_inf2_runtime_image = "vllm/vllm-openai:latest"
aws_inf2_model_id = "Qwen/Qwen3.6-35B-A3B"
aws_inf2_served_model_name = "base-coder"
aws_inf2_api_key = ""
aws_inf2_adapter_bucket = "s3://marketplace-trajectories/adapters"
aws_inf2_agent_id_header = "X-Agent-ID"
aws_inf2_ssh_cidrs = ["0.0.0.0/0"]
aws_inf2_inference_cidrs = ["0.0.0.0/0"]

provision_aws_c8g_cpu_worker = false
aws_c8g_region = "eu-central-1"
aws_c8g_instance_type = "c8g.xlarge"
aws_c8g_ssh_key_name = "your-keypair"
aws_c8g_gguf_model_uri = "s3://marketplace-models/gguf/qwen3.6-worker.gguf"
aws_c8g_served_model_name = "cpu-worker"
aws_c8g_api_key = ""
aws_c8g_llamacpp_image = "ghcr.io/ggml-org/llama.cpp:server"
aws_c8g_ssh_cidrs = ["0.0.0.0/0"]
aws_c8g_inference_cidrs = ["0.0.0.0/0"]
