project                  = "bountynet-marketplace"

listener_port = 443
endpoint_port = 8000

# Replace with deployed NLB ARNs in each region.
endpoint_groups = {
  na_west = {
    region                  = "us-west-2"
    nlb_arn                 = "arn:aws:elasticloadbalancing:us-west-2:123456789012:loadbalancer/net/bountynet-na-west/..."
    traffic_dial_percentage = 20
    weight                  = 128
  }
  na_east = {
    region                  = "us-east-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/net/bountynet-na-east/..."
    traffic_dial_percentage = 20
    weight                  = 128
  }
  eu = {
    region                  = "eu-west-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/net/bountynet-eu/..."
    traffic_dial_percentage = 30
    weight                  = 128
  }
  asia = {
    region                  = "ap-southeast-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:loadbalancer/net/bountynet-asia/..."
    traffic_dial_percentage = 20
    weight                  = 128
  }
  australia = {
    region                  = "ap-southeast-2"
    nlb_arn                 = "arn:aws:elasticloadbalancing:ap-southeast-2:123456789012:loadbalancer/net/bountynet-australia/..."
    traffic_dial_percentage = 10
    weight                  = 128
  }
}
