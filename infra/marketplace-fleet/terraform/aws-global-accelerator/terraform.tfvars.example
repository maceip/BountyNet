project                  = "bountynet-marketplace"

listener_port = 443
endpoint_port = 8000

# Replace with deployed NLB ARNs in each region (Frankfurt -> Ireland -> London fallback chain).
endpoint_groups = {
  frankfurt_primary = {
    region                  = "eu-central-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-central-1:123456789012:loadbalancer/net/bountynet-frankfurt/..."
    traffic_dial_percentage = 60
    weight                  = 128
  }
  ireland_secondary = {
    region                  = "eu-west-1"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:loadbalancer/net/bountynet-ireland/..."
    traffic_dial_percentage = 25
    weight                  = 128
  }
  london_tertiary = {
    region                  = "eu-west-2"
    nlb_arn                 = "arn:aws:elasticloadbalancing:eu-west-2:123456789012:loadbalancer/net/bountynet-london/..."
    traffic_dial_percentage = 15
    weight                  = 128
  }
}
