# ---------- vLLM serving ----------
VLLM_BASE_MODEL=Qwen/Qwen3.6-35B-A3B
VLLM_SPECIALIST_MODEL=Qwen/Qwen3.6-35B-A3B
VLLM_DRAFTER_MODEL=Qwen/Qwen3.6-Flash
VLLM_API_KEY=replace-with-strong-key
# Start conservative for production stability; raise with staged soak:
# 65536 -> 131072 -> 262144
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=256
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_TP_SIZE=1
VLLM_SPEC_TOKENS=8
VLLM_ENFORCE_EAGER=0
VLLM_AGENT_ID_HEADER=X-Agent-ID
VLLM_KV_CACHE_WINDOW_SECONDS=300
VLLM_ADAPTER_BUCKET=s3://marketplace-trajectories/adapters

# ---------- Langfuse ----------
LANGFUSE_NEXTAUTH_SECRET=replace-with-32-plus-char-secret
LANGFUSE_SALT=replace-with-random-salt
LANGFUSE_ENCRYPTION_KEY=replace-with-32-plus-char-key
LANGFUSE_PUBLIC_URL=http://localhost:3001

# ---------- Axolotl ----------
AXOLOTL_OUTPUT_DIR=./axolotl/output
HF_TOKEN=
AXOLOTL_LIGER_ROPE=true
AXOLOTL_FSDP=true
# Stage-1 training length. Raise gradually after stability validation.
AXOLOTL_SEQUENCE_LEN=32768
# Memory preflight guard (1=enabled, 0=disabled)
AXOLOTL_PREFLIGHT=1
# Optional override for preflight estimator
AXOLOTL_AVAILABLE_GPU_MEM_GB=80

# ---------- Weekly evolution loop ----------
# Curated identity traces in S3 (one file per identity, e.g. rust-sentinel.jsonl).
TRAJECTORY_BUCKET=s3://marketplace-trajectories/weekly
# Published adapter artifacts keyed by identity + run id.
ADAPTER_BUCKET=s3://marketplace-trajectories/adapters
# Maintain 256K floor metadata in runtime handoff.
AGENT_RUNTIME_CONTEXT_FLOOR_TOKENS=262144
