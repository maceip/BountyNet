#!/usr/bin/env bash
set -euo pipefail

# env-sync: Push/pull .env secrets via AWS SSM Parameter Store
# Usage:
#   env-sync push [.env file]    - Push all keys from .env to SSM
#   env-sync pull [.env file]    - Pull all keys from SSM to .env
#   env-sync set KEY VALUE       - Set a single key
#   env-sync get KEY             - Get a single key
#   env-sync list                - List all stored keys
#   env-sync delete KEY          - Delete a single key

REGION="${AWS_REGION:-eu-central-1}"
PREFIX="/hackathon"
DEFAULT_ENV=".env"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
cyan()  { printf '\033[0;36m%s\033[0m\n' "$*"; }

cmd_push() {
    local envfile="${1:-$DEFAULT_ENV}"
    if [[ ! -f "$envfile" ]]; then
        red "File not found: $envfile"
        exit 1
    fi
    local count=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip comments and blank lines
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        key="${line%%=*}"
        value="${line#*=}"
        # Strip surrounding quotes
        value="${value#\"}" ; value="${value%\"}"
        value="${value#\'}" ; value="${value%\'}"
        aws ssm put-parameter \
            --name "${PREFIX}/${key}" \
            --value "$value" \
            --type SecureString \
            --overwrite \
            --region "$REGION" \
            > /dev/null
        cyan "  pushed: $key"
        ((count++))
    done < "$envfile"
    green "Pushed $count keys to SSM ${PREFIX}/*"
}

cmd_pull() {
    local envfile="${1:-$DEFAULT_ENV}"
    [[ -f "$envfile" ]] && cp "$envfile" "${envfile}.bak"

    # Single python script handles pagination, JSON parsing, and file writing
    # Use venv python if available (for boto3), otherwise system python
    local PY="${VIRTUAL_ENV:-}/bin/python3"
    [[ ! -x "$PY" ]] && PY="python3"
    "$PY" - "$PREFIX" "$REGION" "$envfile" << 'PYEOF'
import boto3, sys, os
prefix, region, envfile = sys.argv[1], sys.argv[2], sys.argv[3]
client = boto3.client("ssm", region_name=region)
params = []
kwargs = {"Path": prefix + "/", "WithDecryption": True, "Recursive": True, "MaxResults": 10}
while True:
    resp = client.get_parameters_by_path(**kwargs)
    params.extend(resp.get("Parameters", []))
    token = resp.get("NextToken")
    if not token:
        break
    kwargs["NextToken"] = token
if not params:
    print(f"\033[0;31mNo parameters found under {prefix}/\033[0m")
    sys.exit(1)
with open(envfile, "w") as f:
    from datetime import datetime, timezone
    f.write(f"# Auto-generated by env-sync ({datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')})\n")
    for p in sorted(params, key=lambda x: x["Name"]):
        key = p["Name"].rsplit("/", 1)[-1]
        f.write(f"{key}={p['Value']}\n")
        print(f"\033[0;36m  pulled: {key}\033[0m")
os.chmod(envfile, 0o600)
print(f"\033[0;32mPulled {len(params)} keys to {envfile}\033[0m")
PYEOF
}

cmd_set() {
    local key="${1:?Usage: env-sync set KEY VALUE}"
    local value="${2:?Usage: env-sync set KEY VALUE}"
    aws ssm put-parameter \
        --name "${PREFIX}/${key}" \
        --value "$value" \
        --type SecureString \
        --overwrite \
        --region "$REGION" \
        > /dev/null
    green "Set: $key"
}

cmd_get() {
    local key="${1:?Usage: env-sync get KEY}"
    aws ssm get-parameter \
        --name "${PREFIX}/${key}" \
        --with-decryption \
        --region "$REGION" \
        --query 'Parameter.Value' \
        --output text
}

cmd_list() {
    aws ssm get-parameters-by-path \
        --path "$PREFIX/" \
        --recursive \
        --region "$REGION" \
        --query 'Parameters[*].Name' \
        --output text | tr '\t' '\n' | while read -r name; do
        echo "  ${name##*/}"
    done
}

cmd_delete() {
    local key="${1:?Usage: env-sync delete KEY}"
    aws ssm delete-parameter \
        --name "${PREFIX}/${key}" \
        --region "$REGION" > /dev/null
    green "Deleted: $key"
}

case "${1:-help}" in
    push)   shift; cmd_push "$@" ;;
    pull)   shift; cmd_pull "$@" ;;
    set)    shift; cmd_set "$@" ;;
    get)    shift; cmd_get "$@" ;;
    list)   shift; cmd_list "$@" ;;
    delete) shift; cmd_delete "$@" ;;
    *)
        echo "env-sync: Securely sync .env secrets via AWS SSM Parameter Store"
        echo ""
        echo "Usage:"
        echo "  env-sync push [.env]     Push .env keys to SSM (SecureString)"
        echo "  env-sync pull [.env]     Pull all SSM keys into .env"
        echo "  env-sync set KEY VALUE   Set one key"
        echo "  env-sync get KEY         Get one key"
        echo "  env-sync list            List all stored keys"
        echo "  env-sync delete KEY      Remove a key"
        echo ""
        echo "Both laptop and EC2 can use this. Keys stored at ${PREFIX}/* in ${REGION}."
        ;;
esac
