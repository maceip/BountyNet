#!/usr/bin/env python3
"""
Claude Code status line (https://docs.anthropic.com/en/docs/claude-code/statusline).
Reads session JSON on stdin; prints one line with pink bounty[id] and optional +Δ flash
when gateway /credits/<agent_id> "total" increases.
"""
from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

STATE_PATH = os.path.expanduser("~/.bountynet/statusline-state.json")
AGENT_PATH = os.path.expanduser("~/.bountynet/agent.json")

# ANSI: pink / magenta bright
PINK = "\033[38;5;213m"
FLASH = "\033[1;93m"  # bright yellow +1
RESET = "\033[0m"
DIM = "\033[2m"


def _load_json(path: str) -> dict:
    if not os.path.isfile(path):
        return {}
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def _save_json(path: str, data: dict) -> None:
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
    except OSError:
        pass


def _fetch_credits(gateway: str, agent_id: int) -> dict | None:
    url = f"{gateway.rstrip('/')}/credits/{agent_id}"
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=2) as resp:
            return json.load(resp)
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, json.JSONDecodeError):
        return None


def main() -> None:
    raw = sys.stdin.read()
    try:
        sess = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sess = {}

    model = (sess.get("model") or {}).get("display_name", "?")

    if os.environ.get("BOUNTYNET_STATUSLINE_MOCK") == "1":
        state = _load_json(STATE_PATH)
        now = time.time()
        n = int(state.get("mock_invocation", 0)) + 1
        state["mock_invocation"] = n
        mock_rem = 9000 + (n % 5) * 100
        if n % 12 == 0:
            state["flash_until"] = now + 2.8
            state["flash_delta"] = 100
        _save_json(STATE_PATH, state)
        flash = ""
        if now < float(state.get("flash_until", 0)) and state.get("flash_delta"):
            flash = f" {FLASH}+{int(state['flash_delta'])}{RESET}"
        print(f"{DIM}[{model}]{RESET} {PINK}bounty[mock]{RESET} cr {mock_rem:,}{flash}")
        return

    agent = _load_json(AGENT_PATH)
    if not agent:
        print(f"{DIM}[{model}]{RESET} {PINK}bounty[—]{RESET} run `bounty join`")
        return

    aid = int(agent.get("agent_id", 0))
    gw = agent.get("gateway") or "https://gateway.stare.network"

    credits = _fetch_credits(gw, aid)
    total = credits.get("total") if credits else None
    remaining = credits.get("remaining") if credits else None

    state = _load_json(STATE_PATH)
    now = time.time()

    if isinstance(total, int):
        last = state.get("last_total")
        if isinstance(last, int) and total > last:
            state["flash_delta"] = total - last
            state["flash_until"] = now + 3.0
        state["last_total"] = total

    flash_suffix = ""
    if now < float(state.get("flash_until", 0)):
        delta = state.get("flash_delta")
        if delta:
            flash_suffix = f" {FLASH}+{int(delta)}{RESET}"

    _save_json(STATE_PATH, state)

    rem_s = f"{int(remaining):,}" if isinstance(remaining, int) else "—"
    print(f"{DIM}[{model}]{RESET} {PINK}bounty[{aid}]{RESET} cr {rem_s}{flash_suffix}")


if __name__ == "__main__":
    main()
