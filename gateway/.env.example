# Copy to gateway/.env and fill in secrets. Node must be on PATH (for wallet/dynamic_bridge.mjs).

# Dynamic environment (same id as web VITE_DYNAMIC_ENV_ID for one project).
DYNAMIC_ENV_ID=

# Server-side API key — Dashboard → Developers → API Keys (needed for /identity/onboard).
DYNAMIC_API_KEY=

# Listening port for python -m gateway.app
GATEWAY_PORT=8090

# Optional: verify Bearer JWTs on protected routes (inference, etc.)
# DYNAMIC_JWKS_ENDPOINT=https://app.dynamic.xyz/api/v0/sdk/<ENV_ID>/.well-known/jwks

# Optional: /health reports chain stats when escrow + identity are set (Arc testnet defaults in code).
# BOUNTY_ESCROW=
# IDENTITY_REGISTRY=
