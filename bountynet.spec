### 4.2 Solidity Escrow Contract (Circle Settlement)

Deployed on Base Sepolia. Allows Stakers to lock USDC against a specific Context Payload hash.

`BountyNetEscrow.sol`

```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";

contract BountyNetEscrow {
    address public oracle; // CI Oracle (Webhook Verifier) address
    IERC20 public usdc;

    struct Bounty {
        address creator;
        uint256 amount;
        bool resolved;
    }

    // Context Payload Hash -> Bounty Data
    mapping(bytes32 => Bounty) public bounties;

    constructor(address _oracle, address _usdc) {
        oracle = _oracle;
        usdc = IERC20(_usdc);
    }

    /// @notice Staker locks USDC against a specific Context Payload hash
    /// @dev Targets Circle bounty for Agentic Nanopayments
    function createBounty(bytes32 contextHash, uint256 amount) external {
        require(usdc.transferFrom(msg.sender, address(this), amount), "Transfer failed");
        bounties[contextHash] = Bounty(msg.sender, amount, false);
    }

    /// @notice Called by the CI Oracle once the Solver's PR passes CI
    function resolveBounty(bytes32 contextHash, address solver) external {
        require(msg.sender == oracle, "Only oracle can resolve");
        Bounty storage b = bounties[contextHash];
        require(!b.resolved, "Already resolved");
        require(b.amount > 0, "No bounty found");

        b.resolved = true;

        // Payout: 70% to Solver, 30% to Paymaster (reloads Compute Credits)
        uint256 solverShare = (b.amount * 70) / 100;
        uint256 paymasterShare = b.amount - solverShare;

        usdc.transfer(solver, solverShare);
        usdc.transfer(oracle, paymasterShare);
    }
}
```

