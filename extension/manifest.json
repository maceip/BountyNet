{
  "manifest_version": 3,
  "name": "BountyNet",
  "version": "0.0.1",
  "description": "See bounties on GitHub PRs",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["bountynet.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
