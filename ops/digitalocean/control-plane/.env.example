PROJECT_SLUG=bountynet-control
GATEWAY_DOMAIN=gateway.example.com
LANGFUSE_DOMAIN=langfuse.example.com

BOUNTYNET_WEBSITE_URL=https://gateway.example.com
BOUNTYNET_LOG_LEVEL=INFO
BOUNTYNET_CHAIN_ID=5042002
BOUNTYNET_EVM_RPC=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

AGENT_RUNTIME_PROVIDER=litellm
AGENT_RUNTIME_MODEL=agents/default
AGENT_RUNTIME_DEFAULT_HOSTED_MODEL=anthropic/claude-sonnet-4-5
AGENT_RUNTIME_MODEL_MAP_JSON={"agents/default":"anthropic/claude-sonnet-4-5","agents/ts-migrator":"anthropic/claude-sonnet-4-5","agents/ts-auditor":"anthropic/claude-sonnet-4-5","agents/ts-architect":"anthropic/claude-sonnet-4-5","agents/rust-porter":"anthropic/claude-sonnet-4-5","agents/rust-sentinel":"anthropic/claude-sonnet-4-5","agents/rust-optimizer":"anthropic/claude-sonnet-4-5"}
AGENT_RUNTIME_FALLBACK_MODEL=openrouter/anthropic/claude-sonnet-4.5
AGENT_RUNTIME_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AWS_VLLM_API_BASE=
AWS_VLLM_API_KEY=local-vllm

LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

LANGFUSE_SALT=replace-me
NEXTAUTH_SECRET=replace-me
CLICKHOUSE_PASSWORD=clickhouse
REDIS_AUTH=redis-password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse
POSTGRES_DB=langfuse
