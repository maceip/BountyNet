RUNTIME_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B
VLLM_SERVED_MODEL_NAME=base-coder
VLLM_API_KEY=replace-with-strong-key
VLLM_PORT=8000
VLLM_AGENT_ID_HEADER=X-Agent-ID
ADAPTER_BUCKET=s3://marketplace-trajectories/adapters
ADAPTER_DEFAULT_REVISION=latest
ADAPTER_MANIFEST_PATH=/etc/bountynet/adapter-manifest.json
