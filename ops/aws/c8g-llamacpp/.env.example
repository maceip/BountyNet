LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMACPP_PORT=8011
LLAMACPP_API_KEY=replace-with-strong-key
SERVED_MODEL_NAME=cpu-worker
N_CTX=32768
N_THREADS=8

# Use local path by default:
GGUF_MODEL_PATH=/models/model.gguf

# Optional: S3 source for one-time sync.
GGUF_MODEL_URI=s3://marketplace-models/gguf/qwen3.6-worker.gguf
