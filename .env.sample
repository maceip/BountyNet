# Copy to .env (or .env.local) for local development.
# Do not commit real secrets.

# Core gateway
GATEWAY_PORT=8090
BOUNTYNET_DB_PATH=projects/agent-market/demo/local-gateway.db

# Local quality-of-life:
# Allow /health to stay green when you are not running a local chain RPC.
BOUNTYNET_HEALTH_ALLOW_DEGRADED=1

# Chain (optional for local UI/API work)
# BOUNTYNET_EVM_RPC=http://127.0.0.1:8545
# BOUNTYNET_EVM_RPC_FALLBACK=http://127.0.0.1:8545

# Auth/dev helpers
BOUNTYNET_DEV_SKIP_JWT_VERIFICATION=1
BOUNTYNET_DEV_SKIP_GITHUB_WEBHOOK_VERIFY=1
BOUNTYNET_AUTH_DEV_FACTOR_SECRET=local-dev-factor-secret

# Frontend wiring
VITE_GATEWAY_URL=http://127.0.0.1:8090
BOUNTYNET_GATEWAY_URL=http://127.0.0.1:8090

# Infra defaults
MARKET_INFRA_ROOT=infra/marketplace-fleet
# MARKET_INFRA_ENV_FILE=.env.infra.txt
